# Copy this file to .env and fill in the values. .env is gitignored; never commit real keys.

# Google Gemini API key (default vision model). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Mapbox access token (geocoding + directions). Create one at https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=

# Optional: only needed if vision_model is set to claude in config.yaml
ANTHROPIC_API_KEY=
