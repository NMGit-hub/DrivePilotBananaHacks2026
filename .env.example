# Copy this file to .env and fill in the values. .env is gitignored; never commit real keys.

# Anthropic API key: the default vision model is Claude Haiku (vision_model: claude in config.yaml).
ANTHROPIC_API_KEY=

# Mapbox access token (geocoding + directions). A public "pk." token works.
# Create one at https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=

# Optional: only needed if vision_model is set to gemini. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
