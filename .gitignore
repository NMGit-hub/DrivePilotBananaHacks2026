# Secrets
.env
.env.*
!.env.example

# Python environments and caches
.venv/
.venv-*/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Videos, audio and GPS recordings (large, personal or licensed data)
data/videos/
data/gps/
data/audio/
data/wakeword/
data/cache/
*.mp4
*.mov
*.mkv
*.avi
*.webm

# Model weights and downloaded model caches
models/*
# ...except the small trained wake-word model (regenerating it takes hours; see scripts/wakeword/README.md)
!models/wakeword/
models/wakeword/*
!models/wakeword/hey_drivepilot.onnx
!models/wakeword/metrics.json
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.safetensors

# Run output and logs
runs/
logs/
*.log

# Generated audio clips (rebuilt by scripts)
assets/generated/

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# The trained wake-word model is small and slow to regenerate: tracked (must come after the *.onnx rule)
!models/wakeword/hey_drivepilot.onnx
